# Release signing credentials for the NutriMentor Android app.
# Copy to `keystore.properties` (gitignored) and fill in real values.
#
# Generate a keystore first, e.g.:
#   keytool -genkeypair -v -keystore nutrimentor-release.jks \
#     -keyalg RSA -keysize 2048 -validity 10000 -alias nutrimentor
#
# storeFile is resolved relative to the android/ project root.

storeFile=nutrimentor-release.jks
storePassword=CHANGE_ME
keyAlias=nutrimentor
keyPassword=CHANGE_ME
