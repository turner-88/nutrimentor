# Release signing credentials for the SebayaDM Android app.
# Copy to `keystore.properties` (gitignored) and fill in real values.
#
# Generate a keystore first, e.g.:
#   keytool -genkeypair -v -keystore sebaya-release.jks \
#     -keyalg RSA -keysize 2048 -validity 10000 -alias sebaya
#
# storeFile is resolved relative to the android/ project root.

storeFile=sebaya-release.jks
storePassword=CHANGE_ME
keyAlias=sebaya
keyPassword=CHANGE_ME
