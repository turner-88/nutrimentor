# Server
ENV=development
SERVER_HOST=localhost
SERVER_PORT=8080
APP_URL=http://localhost:8080
APP_THEME=sebaya

# JWT
JWT_SECRET=change-me-in-production
JWT_EXPIRATION_HOURS=72

# Database (MariaDB)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=sebaya
DB_USER=root
DB_PASSWORD=

# Firebase Cloud Messaging (push notifications)
# Leave FCM_CREDENTIALS_FILE empty to disable push (sends are logged instead).
FCM_PROJECT_ID=
FCM_CREDENTIALS_FILE=

# Daily log-reminder push (local time, 24h HH:MM)
REMINDER_ENABLED=false
REMINDER_TIME=08:00
