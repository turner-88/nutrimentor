# Server
ENV=development
SERVER_HOST=localhost
SERVER_PORT=8080
APP_URL=http://localhost:8080
APP_THEME=emerald

# JWT
JWT_SECRET=change-me-in-production
JWT_EXPIRATION_HOURS=72

# Database (MariaDB)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=nutrimentor
DB_USER=root
DB_PASSWORD=

# Firebase Cloud Messaging (push notifications)
# Leave FCM_CREDENTIALS_FILE empty to disable push (sends are logged instead).
FCM_PROJECT_ID=nutrimentor-9eb67
FCM_CREDENTIALS_FILE=

# Daily reminder pushes (local time, 24h HH:MM); gated by REMINDER_ENABLED.
# NOTE: values must be bare HH:MM — inline "# comments" are NOT stripped and break parsing.
REMINDER_ENABLED=false
# unanswered daily log: obat, aktivitas, diet, gula darah
REMINDER_TIME=17:00
# unread education articles
ARTICLE_REMINDER_TIME=08:00
