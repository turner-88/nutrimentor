# NutriMentor — production environment.
# Copy to `.env` on the server and fill in the secrets. Loaded by systemd via
# EnvironmentFile (see deploy/nutrimentor.service) and by the `make migrate-*` targets.

# Server — bind to loopback; nginx terminates TLS and proxies in front.
ENV=production
SERVER_HOST=127.0.0.1
SERVER_PORT=8081
APP_URL=https://nutrimentor.remorac.com
APP_THEME=emerald

# JWT — MUST be a strong, unique secret in production (the app refuses to start
# with the default). Generate one, e.g.: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRATION_HOURS=72

# Database (MariaDB) — DB_PASSWORD MUST be set in production.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=nutrimentor
DB_USER=nutrimentor
DB_PASSWORD=

# Firebase Cloud Messaging (push notifications).
# Leave FCM_CREDENTIALS_FILE empty to disable push (sends are logged instead).
# Path is relative to the working directory (/opt/nutrimentor/app).
FCM_PROJECT_ID=nutrimentor-9eb67
FCM_CREDENTIALS_FILE=secrets/fcm-service-account.json

# Daily reminder pushes (local time, 24h HH:MM); gated by REMINDER_ENABLED.
# NOTE: values must be bare HH:MM — inline "# comments" are NOT stripped and break parsing.
REMINDER_ENABLED=false
# unanswered daily log: obat, aktivitas, diet, gula darah
REMINDER_TIME=17:00
# unread education articles
ARTICLE_REMINDER_TIME=08:00
