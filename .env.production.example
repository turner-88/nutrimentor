# SebayaDM — production environment.
# Copy to `.env` on the server and fill in the secrets. Loaded by systemd via
# EnvironmentFile (see deploy/sebaya.service) and by the `make migrate-*` targets.

# Server — bind to loopback; nginx terminates TLS and proxies in front.
ENV=production
SERVER_HOST=127.0.0.1
SERVER_PORT=8081
APP_URL=https://sebayadm.remorac.com
APP_THEME=emerald

# JWT — MUST be a strong, unique secret in production (the app refuses to start
# with the default). Generate one, e.g.: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRATION_HOURS=72

# Database (MariaDB) — DB_PASSWORD MUST be set in production.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=sebaya
DB_USER=sebaya
DB_PASSWORD=

# Firebase Cloud Messaging (push notifications).
# Leave FCM_CREDENTIALS_FILE empty to disable push (sends are logged instead).
# Path is relative to the working directory (/opt/sebaya/app).
FCM_PROJECT_ID=
FCM_CREDENTIALS_FILE=secrets/fcm-service-account.json

# Daily log-reminder push (local time, 24h HH:MM)
REMINDER_ENABLED=false
REMINDER_TIME=08:00
